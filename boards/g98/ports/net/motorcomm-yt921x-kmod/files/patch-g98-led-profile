+static int
+yt921x_configure_leds(struct yt921x_softc *sc, phandle_t node)
+{
+	u_int hwport;
+	int error;
+
+	if (!OF_hasprop(node, "motorcomm,bdy-g98-led-profile"))
+		return (0);
+	for (u_int port = 0; port < YT921X_CPU_PORT; port++) {
+		hwport = yt921x_hwport(port);
+		error = yt921x_write(sc, YT921X_LED_CTRL0(hwport),
+		    YT921X_LED_G98_LINK);
+		if (error == 0)
+			error = yt921x_write(sc, YT921X_LED_CTRL1(hwport),
+			    YT921X_LED_G98_ACTIVITY);
+		if (error != 0)
+			return (error);
+	}
+	return (0);
+}
