+
+static void
+rge_apply_g98_led_profile(struct rge_softc *sc)
+{
+#ifdef FDT
+	static const bus_size_t ledregs[] = {
+		RGE_LEDSEL0, RGE_LEDSEL1, RGE_LEDSEL2, RGE_LEDSEL3
+	};
+	phandle_t root;
+	int i;
+
+	root = OF_finddevice("/");
+	if (root <= 0 ||
+	    !ofw_bus_node_is_compatible(root, "g98,rk3588") ||
+	    pci_get_device(sc->sc_dev) != PCI_PRODUCT_REALTEK_RTL8125B ||
+	    pci_get_subvendor(sc->sc_dev) != 0x1043 ||
+	    pci_get_subdevice(sc->sc_dev) != 0x208f)
+		return;
+
+	RGE_WRITE_1(sc, RGE_EECMD, RGE_EECMD_WRITECFG);
+	DELAY(50000);
+	RGE_WRITE_1(sc, RGE_CFG1, 0xcf);
+	for (i = 0; i < nitems(ledregs); i++)
+		RGE_WRITE_2(sc, ledregs[i], RGE_G98_LEDSEL);
+	DELAY(100000);
+	device_printf(sc->sc_dev,
+	    "G98 LED profile cfg1=%#02x led=%#04x/%#04x/%#04x/%#04x\n",
+	    RGE_READ_1(sc, RGE_CFG1), RGE_READ_2(sc, RGE_LEDSEL0),
+	    RGE_READ_2(sc, RGE_LEDSEL1), RGE_READ_2(sc, RGE_LEDSEL2),
+	    RGE_READ_2(sc, RGE_LEDSEL3));
+	RGE_WRITE_1(sc, RGE_EECMD, 0x11);
+#endif
+}
 
